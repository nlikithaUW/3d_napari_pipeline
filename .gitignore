# Raw / derived microscopy data (too large for git; folder structure kept via .gitkeep)
*.nd2
*.tif
*.tiff

# Python
__pycache__/
*.pyc
*.pyo

# Editor/OS lock & temp files
~$*
.DS_Store
Thumbs.db

# Claude Code local config
.claude/

# Scratch analysis: test plots, one-off scripts, intermediate output.
# The tracked docs are docs/ISSUES.md and docs/audit.md — do NOT ignore docs/
# itself, the public README links into it.
docs/scratch/*
!docs/scratch/.gitkeep

# Archives
*.7z
*.zip
*.npy
*_saved/
*.csv
Miniforge3-*.sh
.Rhistory
3d_images_folder/images/
*.xlsx
*.png
*.jpg
Nliki/
